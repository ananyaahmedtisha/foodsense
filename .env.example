# Supabase — create a project at https://supabase.com then paste values here
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here

# Admin login (Supabase Auth user — create in Supabase Dashboard > Authentication)
# No extra env needed; middleware protects /admin via Supabase session.

# Impact tracker defaults (shown before live data loads)
NEXT_PUBLIC_IMPACT_GOAL=400
